#!/usr/bin/env bash

export DIRENV_WARN_TIMEOUT=20s

# Enter the flake dev shell. devenv is consumed through the flake's
# `devShells.default` (flake.nix -> devenv/default.nix), so direnv must use the
# same `--impure` flake evaluation path that CI and AGENTS.md use
# (`nix develop --impure`) — there is no root devenv.nix/devenv.yaml.
use flake . --impure
