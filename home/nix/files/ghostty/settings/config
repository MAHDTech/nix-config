##################################################
# Ghostty configuration
##################################################

# NOTE: To see all available config options and their default values run:
#   ghostty +show-config --default --docs
# Or see https://ghostty.org/docs/config.

##################################################
# Theme
##################################################

# Use custom TARS theme with dark/light variants.
# Run `ghostty +list-themes` to see available themes.
theme = dark:TARS Dark,light:TARS Light

##################################################
# Colors
##################################################

# background / foreground are inherited from the theme above.
# Uncomment to override:
# background = #1e1e2e
# foreground = #cdd6f4

# Slightly transparent background — set to 1 for fully opaque.
background-opacity = 0.95

# Blur the background behind the transparency (KDE Plasma / macOS).
background-blur = true

# Ensure readable contrast even with dim palette colours.
minimum-contrast = 1.1

# Dim unfocused splits less aggressively.
unfocused-split-opacity = 0.85

##################################################
# Font
##################################################

# JetBrains Mono is an excellent coding font with ligatures and
# good Nerd Font coverage. Change to your preference.
# Run `ghostty +list-fonts` to see what's available.
font-family = JetBrainsMono Nerd Font
font-family = Noto Color Emoji

# Comfortable reading size — bump up if on HiDPI.
font-size = 13

# Enable all common ligature features.
font-feature = calt
font-feature = liga
font-feature = dlig

# Break ligatures under the cursor so you can see individual chars.
font-shaping-break = cursor

# Good anti-aliasing on Linux (FreeType).
freetype-load-flags = hinting,no-force-autohint,no-monochrome,autohint

# Better colour rendering.
alpha-blending = linear-corrected

##################################################
# Cursor  (fixes the "overtype / block cursor" issue)
##################################################

# Default to a blinking bar cursor.
# Shell integration will keep it as a bar at prompts automatically.
# Programs like Neovim or Vim will switch to block/underline as needed
# via CSI q escape sequences — that is intentional and correct.
cursor-style = bar
cursor-style-blink = true

# Colour the cursor so it stands out on any background.
# cursor-color = #f5c2e7

##################################################
# Shell integration
##################################################

# Auto-detect shell and inject integration (enables prompt marking,
# working-directory inheritance, and more).
shell-integration = detect

# Enable cursor bar at prompt + window title from shell.
# Add sudo if you want Ghostty's terminfo preserved under sudo.
shell-integration-features = cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path

##################################################
# Window & layout
##################################################

# Comfortable padding around the text grid.
window-padding-x = 8
window-padding-y = 6

# Balance remaining pixel space across all sides (looks cleaner).
window-padding-balance = true

# Match window chrome to the terminal background colour on GTK.
window-theme = ghostty

# Show a subtitle with the current working directory.
window-subtitle = working-directory

# New splits/tabs inherit the working directory.
window-inherit-working-directory = true

# New splits/tabs inherit the font size if you've zoomed in/out.
window-inherit-font-size = true

# Hide the mouse pointer while typing.
mouse-hide-while-typing = true

# Scroll to bottom on any keystroke.
scroll-to-bottom = keystroke,no-output

##################################################
# Scrollback & clipboard
##################################################

# 10 MB scrollback (default, but explicit is better).
scrollback-limit = 10000000

# Copy selected text to primary selection clipboard (Linux standard).
copy-on-select = true

# Trim trailing spaces when copying.
clipboard-trim-trailing-spaces = true

# Protect against paste-injection attacks.
clipboard-paste-protection = true

##################################################
# URL handling
##################################################

link-url = true
link-previews = true
