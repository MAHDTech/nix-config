+        #define MVE_BUFFER_ENC_STATS_FLAG_QP         (1<<2)
+        #define MVE_BUFFER_ENC_STATS_FLAG_DROP       (1<<3)
+    uint16_t stats_mb_width;
+    uint16_t stats_mb_height;
+};
