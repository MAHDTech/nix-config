+static int rtl8125_enable_eee_plus(struct rtl8125_private *tp)
+{
+        rtl8125_mac_ocp_write(tp, 0xE080, rtl8125_mac_ocp_read(tp, 0xE080)|BIT_1);
+
+        return 0;
+}
+
+static int rtl8125_disable_eee_plus(struct rtl8125_private *tp)
+{
+        rtl8125_mac_ocp_write(tp, 0xE080, rtl8125_mac_ocp_read(tp, 0xE080)&~BIT_1);
+
+        return 0;
+}
