+{
+    switch (gop) {
+    case MVX_GOP_TYPE_BIDIRECTIONAL:
+        *mve_arg = MVE_OPT_GOP_TYPE_BIDIRECTIONAL;
+        break;
+    case MVX_GOP_TYPE_LOW_DELAY:
