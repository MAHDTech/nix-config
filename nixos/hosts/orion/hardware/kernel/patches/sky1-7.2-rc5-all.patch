+	pci_read_config_dword(rc_pdev, rc_l1ss_offset + PCI_L1SS_CTL1, &rc_l1ssctrl_default);
+	pci_read_config_dword(ep_pdev, ep_l1ss_offset + PCI_L1SS_CTL1, &ep_l1ssctrl_default);
