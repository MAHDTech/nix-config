+    MVX_SESSION_INFO(session, "v4l2: Destroy session.");
+
+    mvx_session_destruct(session);
+
+    if (IS_ENABLED(CONFIG_DEBUG_FS))
+        debugfs_remove_recursive(s->dentry);
