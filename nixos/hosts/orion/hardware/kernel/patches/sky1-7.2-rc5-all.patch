+static void
+rtl8125_issue_offset_99_event(struct rtl8125_private *tp)
+{
+        rtl8125_mac_ocp_write(tp, 0xE09A,  rtl8125_mac_ocp_read(tp, 0xE09A) | BIT_0);
+}
