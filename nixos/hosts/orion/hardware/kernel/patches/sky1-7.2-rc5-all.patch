diff --git a/drivers/media/platform/cix/mvx_log_ram.h b/drivers/media/platform/cix/mvx_log_ram.h
new file mode 100755
index 000000000..1f0d95d39
--- /dev/null
+++ b/drivers/media/platform/cix/mvx_log_ram.h
@@ -0,0 +1,212 @@
+/*
