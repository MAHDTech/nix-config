+                            u16 RegAddr,
+                            u16 value)
+{
+        if (RegAddr == 0x1F) {
+                tp->cur_page = value;
+                return;
+        }
+        rtl8126_mdio_real_write_phy_ocp(tp, tp->cur_page, RegAddr, value);
+}
