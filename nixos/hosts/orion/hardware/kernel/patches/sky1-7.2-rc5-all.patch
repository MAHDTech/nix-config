+void generate_quant_tbl(int quality,
+            const uint8_t qtbl_ref[MVX_FW_QUANT_LEN],
+            uint8_t qtbl[MVX_FW_QUANT_LEN])
+{
+    int i;
+    int q;
+    int t;
+
+    q = (quality < 50) ? (5000 / quality) : (200 - 2 * quality);
+
+    for (i = 0; i < MVX_FW_QUANT_LEN; ++i) {
+        t = ((qtbl_ref[i] * q) + 50) / 100;
+        t = min_t(int, t, 255);
+        t = max_t(int, t, 1);
+        qtbl[i] = t;
+    }
+}
