+/**
+ * mvx_session_port_show() - Print debug information into seq-file.
+ * @port:    Pointer to port.
+ * @s:        Seq-file to print to.
+ */
+void mvx_session_port_show(struct mvx_session_port *port,
+               struct seq_file *s);
