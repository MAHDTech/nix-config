+    enum mvx_gop_type gop_type;
+    enum mvx_entropy_mode entropy_mode;
+    enum mvx_multi_slice_mode multi_slice_mode;
+    enum mvx_vp9_prob_update vp9_prob_update;
+    enum mvx_rgb_to_yuv_mode rgb_to_yuv_mode;
+    int32_t i32_val;
+    bool bool_val;
