+#define MVX_IS_LEGACY_FORMAT(format) \
+    (!((format) == MVX_FORMAT_AV1 || (format) == MVX_FORMAT_HEVC || \
+      (format) == MVX_FORMAT_H264 || (format) == MVX_FORMAT_VP9 || \
+      (format) == MVX_FORMAT_AVS2))
