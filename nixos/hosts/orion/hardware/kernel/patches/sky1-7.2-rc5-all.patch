+static bool sky1_pcie_is_x211(struct sky1_pcie *pcie)
+{
+	return ((pcie->desc->id == PCIE_ID_x2) ||
+		(pcie->desc->id == PCIE_ID_x1_1) ||
+		(pcie->desc->id == PCIE_ID_x1_0)) ?
