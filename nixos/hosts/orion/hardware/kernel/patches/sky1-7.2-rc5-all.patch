+        #define MVE_FORMAT_RGBA_8888      ( (MVE_CHROMA_FORMAT_ARGB << MVE_FORMAT_BF_C) | \
+                                            (              ( 8 - 8) << MVE_FORMAT_BF_B) | \
+                                            (                     1 << MVE_FORMAT_BF_N) | \
+                                            (                     0 << MVE_FORMAT_BF_V) )
+
+        #define MVE_FORMAT_BGRA_8888      ( (MVE_CHROMA_FORMAT_ARGB << MVE_FORMAT_BF_C) | \
+                                            (              ( 8 - 8) << MVE_FORMAT_BF_B) | \
+                                            (                     1 << MVE_FORMAT_BF_N) | \
+                                            (                     1 << MVE_FORMAT_BF_V) )
+
+        #define MVE_FORMAT_ARGB_8888      ( (MVE_CHROMA_FORMAT_ARGB << MVE_FORMAT_BF_C) | \
+                                            (              ( 8 - 8) << MVE_FORMAT_BF_B) | \
+                                            (                     1 << MVE_FORMAT_BF_N) | \
+                                            (                     2 << MVE_FORMAT_BF_V) )
