+#define PANTHOR_SCMI_MAX_ERRORS		3		/* errors before safe-freq boost */
+#define PANTHOR_SCMI_BACKOFF_BASE_US	500000		/* 500ms base backoff */
+#define PANTHOR_SCMI_BACKOFF_MAX_US	4000000		/* 4s max backoff */
