+/**
+ * trilin_dp_aux_cleanup - Cleanup the DP AUX
+ * @dp: DisplayPort IP core structure
+ *
+ * Unregister the DP AUX adapter.
+ */
+static void trilin_dp_aux_cleanup(struct trilin_dp *dp)
+{
+	drm_dp_aux_unregister(&dp->aux);
+}
