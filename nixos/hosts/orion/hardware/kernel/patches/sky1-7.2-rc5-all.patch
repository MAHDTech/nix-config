+        break;
+    case MVX_GOP_TYPE_GDR:
+        *mve_arg = MVE_OPT_GOP_TYPE_GDR;
+        break;
+    default:
+        return -EINVAL;
+    }
+
+    return 0;
+}
+
+static int to_mve_h264_cabac(enum mvx_entropy_mode entropy_mode,
+                 unsigned int *mve_arg)
+{
+    switch (entropy_mode) {
+    case MVX_ENTROPY_MODE_CABAC:
+        *mve_arg = 1;
+        break;
+    case MVX_ENTROPY_MODE_CAVLC:
+        *mve_arg = 0;
