+	linlondp_write32(reg, BLK_SIZE, HV_SIZE(st->hsize, st->vsize));
+	linlondp_write32(reg, SP_OVERLAP_SIZE, st->overlap & 0x1FFF);
+	linlondp_write32(reg, BLK_CONTROL, BLK_CTRL_EN);
+}
