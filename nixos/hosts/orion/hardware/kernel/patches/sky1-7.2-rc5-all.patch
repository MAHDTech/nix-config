+            uint16_t x; //included
+            /* top start y of luma in original image */
+            uint16_t y; //included
+            /* cropped width of luma in original image */
+            uint16_t width;
+            /* cropped height of luma in original image */
+            uint16_t height;
+        } enc_src_crop;
+
+        struct
+        {
+            uint8_t crop_en;
+            /* left start x of luma in original image */
+            uint16_t x; //included
+            /* top start y of luma in original image */
+            uint16_t y; //included
+            /* cropped width of luma in original image */
+            uint16_t width;
+            /* cropped height of luma in original image */
+            uint16_t height;
+        } dec_dst_crop;  //ENABLE_DST_CROP
+    } data;
+};
