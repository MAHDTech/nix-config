+	CFG(CLK_DMAC_AXI, "audss_dmac_axi", dmac_axi_parent,
+	    -1, 0, 0, 0, INFO_CLK_DIV, 0, 2, 0, INFO_CLK_GATE, 15, 0, CLK_GET_RATE_NOCACHE),
+	/* Watchdog */
+	CFG(CLK_WDG_APB, "audss_wdg_apb", wdg_parent,
+	    -1, 0, 0, 0, -1, 0, 0, 0, INFO_CLK_GATE, 10, 0, CLK_GET_RATE_NOCACHE),
+	CFG(CLK_WDG_WDG, "audss_wdg_wdg", wdg_parent,
