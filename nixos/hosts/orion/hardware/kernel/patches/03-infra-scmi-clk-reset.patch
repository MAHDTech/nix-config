+	CFG(CLK_TIMER_TIMER, "audss_timer_timer", timer_timer_parent,
+	    -1, 0, 0, 0, -1, 0, 0, 0, INFO_CLK_GATE, 11, 0, CLK_GET_RATE_NOCACHE),
+	/* Mailbox */
+	CFG(CLK_MB_0_APB, "audss_mb_0_apb", mailbox_apb_parent,
+	    -1, 0, 0, 0, -1, 0, 0, 0, INFO_CLK_GATE, 12, 0, CLK_GET_RATE_NOCACHE),
+	CFG(CLK_MB_1_APB, "audss_mb_1_apb", mailbox_apb_parent,
+	    -1, 0, 0, 0, -1, 0, 0, 0, INFO_CLK_GATE, 13, 0, CLK_GET_RATE_NOCACHE),
+	/* I2S APB clocks */
+	CFG(CLK_I2S0_APB, "audss_i2s0_apb", i2s_apb_parent,
+	    -1, 0, 0, 0, INFO_CLK_DIV, 0, 2, 0, INFO_CLK_GATE, 0, 0, CLK_GET_RATE_NOCACHE),
+	CFG(CLK_I2S1_APB, "audss_i2s1_apb", i2s_apb_parent,
+	    -1, 0, 0, 0, INFO_CLK_DIV, 0, 2, 0, INFO_CLK_GATE, 1, 0, CLK_GET_RATE_NOCACHE),
