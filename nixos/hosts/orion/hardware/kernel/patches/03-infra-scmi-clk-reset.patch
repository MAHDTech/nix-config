+	/* SRAM */
+	CFG(CLK_SRAM_AXI, "audss_sram_axi", sram_axi_parent,
+	    -1, 0, 0, 0, INFO_CLK_DIV, 0, 2, 0, INFO_CLK_GATE, 16, 0, CLK_GET_RATE_NOCACHE),
+	/* HDA */
+	CFG(CLK_HDA_SYS, "audss_hda_sys", hda_sys_parent,
+	    -1, 0, 0, 0, INFO_CLK_DIV, 0, 2, 0, INFO_CLK_GATE, 14, 0, CLK_GET_RATE_NOCACHE),
+	CFG(CLK_HDA_HDA, "audss_hda_hda", hda_hda_parent,
