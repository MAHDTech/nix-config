+	CFG(CLK_I2S1, "audss_i2s1", i2s_sc_parents,
+	    INFO_CLK_MUX, 2, 2, 0, INFO_CLK_DIV, 4, 2, 0, INFO_CLK_GATE, 1, 0, CLK_GET_RATE_NOCACHE),
