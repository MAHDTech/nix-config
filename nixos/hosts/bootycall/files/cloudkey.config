# =============================================================================
# CloudKey Gen2 Plus — Minimal kernel config fragment
# =============================================================================
# Designed for: allnoconfig base + merge_config.sh + olddefconfig
# Source:        msm8953-mainline/linux v7.0.9
# Device:        Ubiquiti UniFi CloudKey Gen2 Plus (APQ8053)
#
# IMPORTANT: With allnoconfig, Kconfig silently discards any option whose
# parent menu or dependency is disabled. Every leaf option MUST have its
# full dependency chain explicitly enabled here.
#
# Usage in kernel build:
#   make ARCH=arm64 allnoconfig
#   scripts/kconfig/merge_config.sh -m .config THIS_FILE
#   make ARCH=arm64 olddefconfig
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Architecture & Core (ARM64, Qualcomm, 8x Cortex-A53)
# -----------------------------------------------------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM_PSCI_FW=y
CONFIG_SCHED_MC=y
CONFIG_HZ_250=y

# OF/DeviceTree support
CONFIG_OF=y

# 64-bit userspace
CONFIG_COMPAT=y

# Kernel modules support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Misc core features
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYSCTL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y

# Block layer
CONFIG_BLOCK=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y

# Size optimization
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable debug symbols (shrink kernel)
# CONFIG_DEBUG_INFO is not set

# Expert mode (required for EMBEDDED and fine-grained control)
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y

# -----------------------------------------------------------------------------
# 2. Qualcomm Platform Core (APQ8053/MSM8953)
# -----------------------------------------------------------------------------
# CRITICAL: CONFIG_MAILBOX is required by CONFIG_RPMSG_QCOM_SMD.
# Without it, the entire RPM/clock/regulator driver chain is silently
# discarded by Kconfig, causing immediate SoC hang at early boot.
# -----------------------------------------------------------------------------

# Mailbox framework (parent dependency for RPMSG_QCOM_SMD)
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y

# Secure Channel Manager (TrustZone communication)
CONFIG_QCOM_SCM=y

# Shared memory (inter-processor communication)
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y

# RPM (Resource Power Manager) communication
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMCC=y

# GLINK RPM (alternative RPM transport)
CONFIG_RPMSG_QCOM_GLINK_RPM=y

# Clock framework
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_MSM_GCC_8953=y
CONFIG_QCOM_CLK_APCS_MSM8953=y

# Pin controller
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_MSM8953=y

# Regulators (PMIC voltage rails via RPM)
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y

# SPMI bus (PMIC communication)
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y

# Power domains
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_QCOM_RPMPD=y

# Interconnect (bus bandwidth management)
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8953=y

# SMP2P (inter-processor signaling) — depends on MAILBOX
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y

# IOMMU / SMMU
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_IOMMU=y

# Watchdog
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# Thermal — depends on THERMAL + QCOM_TSENS needs NVMEM
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y

# CPR (Core Power Reduction / adaptive voltage scaling)
CONFIG_QCOM_CPR=y

# GPIO
CONFIG_GPIOLIB=y

# NVMEM (fuses/efuses — required by QCOM_TSENS and CPR)
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y

# -----------------------------------------------------------------------------
# 3. eMMC (boot disk — /dev/mmcblk0)
# -----------------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# -----------------------------------------------------------------------------
# 4. USB (boot-critical: ASIX AX88179 USB Ethernet is our ONLY network)
# -----------------------------------------------------------------------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_NOP_USB_XCEIV=y

# USB Ethernet (ASIX AX88179 — the CloudKey's only NIC)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_MII=y

# USB storage (modules — for SATA HDD bridge ASM1153E)
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=m

# -----------------------------------------------------------------------------
# 5. Serial Console (UART — ttyMSM0)
# -----------------------------------------------------------------------------
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
# Serial device bus
CONFIG_SERIAL_DEV_BUS=y
# Early console for boot debugging
CONFIG_SERIAL_EARLYCON=y

# VT/console
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y

# -----------------------------------------------------------------------------
# 6. Networking (TCP/IP, netconsole)
# -----------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y
CONFIG_NETCONSOLE=y
# NETCONSOLE_DYNAMIC requires CONFIGFS_FS
CONFIG_CONFIGFS_FS=y
CONFIG_NETCONSOLE_DYNAMIC=y

# IPv6 (NixOS services may need it)
CONFIG_IPV6=y

# DNS resolver (for NixOS)
CONFIG_DNS_RESOLVER=y

# -----------------------------------------------------------------------------
# 7. Filesystems
# -----------------------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVTMPFS_SAFE=y

# CRITICAL: MISC_FILESYSTEMS is a parent menu required by PSTORE and SQUASHFS.
# Without it, both are silently discarded by Kconfig.
CONFIG_MISC_FILESYSTEMS=y

# NixOS store and initrd
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_AUTOFS_FS=y

# initramfs/initrd support
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# -----------------------------------------------------------------------------
# 8. NixOS Requirements (cgroups, namespaces, security)
# -----------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_KEYS=y

# systemd requirements
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Audit (some NixOS services depend on it)
CONFIG_AUDIT=y

# POSIX ACLs
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# -----------------------------------------------------------------------------
# 9. PSTORE / Ramoops (crash debugging) — depends on MISC_FILESYSTEMS
# -----------------------------------------------------------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set

# -----------------------------------------------------------------------------
# 10. OLED Display (ST7735R via SPI — nice to have)
# -----------------------------------------------------------------------------
CONFIG_SPI=y
CONFIG_SPI_QUP=y
CONFIG_FB=y
CONFIG_STAGING=y
# FB_TFT requires BACKLIGHT_CLASS_DEVICE
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB_TFT=m
CONFIG_FB_TFT_ST7735R=m

# -----------------------------------------------------------------------------
# 11. Input (minimal — for reboot/shutdown buttons)
# -----------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# -----------------------------------------------------------------------------
# 12. Crypto (for dm-crypt, networking, btrfs checksums)
# -----------------------------------------------------------------------------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_HASH_INFO=y
CONFIG_CRYPTO_SKCIPHER=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_LIB_SHA256=y
CONFIG_CRC32=y
CONFIG_CRC_T10DIF=y
CONFIG_LIBCRC32C=y
# ARM hardware crypto — corrected option names for v7.0.9
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y

# -----------------------------------------------------------------------------
# 13. Misc required infrastructure
# -----------------------------------------------------------------------------
# DMA engine (required by SPI, UART, etc.)
CONFIG_DMADEVICES=y
CONFIG_QCOM_BAM_DMA=y

# Reset controller
CONFIG_RESET_CONTROLLER=y

# RTC (timekeeping)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y

# Firmware loader
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# SCSI (needed for USB storage / UAS)
CONFIG_SCSI_MOD=y

# Async SCSI scan (faster boot)
CONFIG_SCSI_SCAN_ASYNC=y
