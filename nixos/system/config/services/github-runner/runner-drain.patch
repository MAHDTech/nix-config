+        private async Task<TaskAgentMessage> GetNextMessageOrDrainAsync(CancellationToken token)
+        {
+            string marker = Environment.GetEnvironmentVariable("GITHUB_RUNNER_DRAIN_MARKER");
+            if (string.IsNullOrEmpty(marker))
+            {
+                return await _listener.GetNextMessageAsync(token);
+            }
+
+            if (File.Exists(marker))
+            {
+                return null;
+            }
+
+            using var pollToken = CancellationTokenSource.CreateLinkedTokenSource(token);
+            Task<TaskAgentMessage> nextMessage = _listener.GetNextMessageAsync(pollToken.Token);
+            while (!nextMessage.IsCompleted)
+            {
+                token.ThrowIfCancellationRequested();
+                if (File.Exists(marker))
+                {
+                    pollToken.Cancel();
+                    try
+                    {
+                        // A received message wins the race with draining and must be handled.
+                        return await nextMessage;
+                    }
+                    catch (OperationCanceledException) when (!token.IsCancellationRequested)
+                    {
+                        return null;
+                    }
+                }
+
+                await Task.WhenAny(nextMessage, Task.Delay(1000, token));
+            }
+
+            return await nextMessage;
+        }
